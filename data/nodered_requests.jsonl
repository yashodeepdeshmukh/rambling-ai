{"id": "kitchen_alert", "text": "When the temperature on MQTT topic sensors/kitchen goes above 30, POST it to https://hooks.example.com/alert.", "template": "mqtt_threshold_webhook", "slots": {"broker": "localhost", "topic": "sensors/kitchen", "property": "payload.temperature", "operator": "greater than", "threshold": "30", "method": "POST", "url": "https://hooks.example.com/alert"}}
{"id": "pressure_drop", "text": "Subscribe to factory/line1/pressure on broker mqtt.factory.local and if pressure drops below 2 send a GET request to https://ops.example.com/notify", "template": "mqtt_threshold_webhook", "slots": {"broker": "mqtt.factory.local", "topic": "factory/line1/pressure", "property": "payload.pressure", "operator": "less than", "threshold": "2", "method": "GET", "url": "https://ops.example.com/notify"}}
{"id": "watch_livingroom", "text": "Show me everything published on home/livingroom/# in the debug panel.", "template": "mqtt_monitor", "slots": {"broker": "localhost", "topic": "home/livingroom/#"}}
{"id": "watch_soil", "text": "Monitor the MQTT topic garden/soil from broker 192.168.1.20 and print the messages.", "template": "mqtt_monitor", "slots": {"broker": "192.168.1.20", "topic": "garden/soil"}}
{"id": "bridge_legacy", "text": "Bridge messages from legacy/temp to sensors/temperature on localhost.", "template": "mqtt_bridge", "slots": {"broker": "localhost", "topic_in": "legacy/temp", "topic_out": "sensors/temperature"}}
{"id": "bridge_plant", "text": "Copy every message on plant/a/status over to dashboard/plant-a.", "template": "mqtt_bridge", "slots": {"broker": "localhost", "topic_in": "plant/a/status", "topic_out": "dashboard/plant-a"}}
{"id": "poll_weather", "text": "Every 10 minutes fetch https://api.example.com/v1/weather and show the JSON in debug.", "template": "poll_http_debug", "slots": {"interval": "600 seconds", "url": "https://api.example.com/v1/weather"}}
{"id": "poll_health", "text": "Poll https://status.example.org/health every 30 seconds so I can see it in the debug sidebar.", "template": "poll_http_debug", "slots": {"interval": "30 seconds", "url": "https://status.example.org/health"}}
{"id": "prices_to_mqtt", "text": "Every hour, download https://api.example.com/prices and publish the response to MQTT topic market/prices.", "template": "poll_http_to_mqtt", "slots": {"interval": "3600 seconds", "url": "https://api.example.com/prices", "broker": "localhost", "topic": "market/prices"}}
{"id": "air_to_mqtt", "text": "Grab https://data.example.net/air.json every 5 minutes and push it to city/air on broker iot.example.net.", "template": "poll_http_to_mqtt", "slots": {"interval": "300 seconds", "url": "https://data.example.net/air.json", "broker": "iot.example.net", "topic": "city/air"}}
{"id": "echo_post", "text": "Make a POST endpoint at /echo that sends back whatever JSON it receives.", "template": "http_echo", "slots": {"method": "POST", "path": "/echo"}, "probes": [{"method": "POST", "path": "/echo", "json": {"hello": "world"}, "expect_contains": "world"}]}
{"id": "echo_ping", "text": "I need a GET /ping endpoint that returns the query parameters.", "template": "http_echo", "slots": {"method": "GET", "path": "/ping"}, "probes": [{"method": "GET", "path": "/ping?name=bob", "expect_contains": "bob"}]}
{"id": "check_temp", "text": "Create an endpoint /check that answers ALERT when the posted temperature is above 40 and OK otherwise.", "template": "http_threshold", "slots": {"path": "/check", "property": "payload.temperature", "operator": "greater than", "threshold": "40"}, "probes": [{"method": "POST", "path": "/check", "json": {"temperature": 45}, "expect_contains": "ALERT"}, {"method": "POST", "path": "/check", "json": {"temperature": 20}, "expect_contains": "OK"}]}
{"id": "battery", "text": "Expose /battery: reply ALERT if the level in the request is below 15, else OK.", "template": "http_threshold", "slots": {"path": "/battery", "property": "payload.level", "operator": "less than", "threshold": "15"}, "probes": [{"method": "POST", "path": "/battery", "json": {"level": 10}, "expect_contains": "ALERT"}, {"method": "POST", "path": "/battery", "json": {"level": 80}, "expect_contains": "OK"}]}
{"id": "log_requests", "text": "Accept POSTs on /log and append each body to /tmp/rambling-nr/requests.log.", "template": "webhook_to_file", "slots": {"path": "/log", "file": "/tmp/rambling-nr/requests.log"}, "probes": [{"method": "POST", "path": "/log", "json": {"order": 1234}, "expect_contains": "saved", "expect_file": {"path": "/tmp/rambling-nr/requests.log", "contains": "1234"}}]}
{"id": "save_events", "text": "Save every webhook hitting /events into the file /tmp/rambling-nr/events.txt.", "template": "webhook_to_file", "slots": {"path": "/events", "file": "/tmp/rambling-nr/events.txt"}, "probes": [{"method": "POST", "path": "/events", "json": {"event": "signup"}, "expect_contains": "saved", "expect_file": {"path": "/tmp/rambling-nr/events.txt", "contains": "signup"}}]}
{"id": "door_throttle", "text": "Forward alarms/door messages to https://hooks.example.com/door but at most once every 5 seconds.", "template": "rate_limit_forward", "slots": {"broker": "localhost", "topic": "alarms/door", "interval": "5 seconds", "url": "https://hooks.example.com/door"}}
{"id": "motion_throttle", "text": "Throttle sensor/motion to one webhook call per minute to https://api.example.com/motion.", "template": "rate_limit_forward", "slots": {"broker": "localhost", "topic": "sensor/motion", "interval": "60 seconds", "url": "https://api.example.com/motion"}}
{"id": "clock_tick", "text": "Publish the current time to clock/tick every second.", "template": "timer_publish", "slots": {"interval": "1 seconds", "broker": "localhost", "topic": "clock/tick"}}
{"id": "heartbeat", "text": "Send a heartbeat timestamp to devices/gw1/heartbeat every 30 seconds on broker mqtt.example.com.", "template": "timer_publish", "slots": {"interval": "30 seconds", "broker": "mqtt.example.com", "topic": "devices/gw1/heartbeat"}}
